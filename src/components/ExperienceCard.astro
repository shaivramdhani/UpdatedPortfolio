---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"experience">;
};

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<article class="surface p-6 sm:p-8">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
    <div class="max-w-2xl space-y-3">
      <div class="space-y-1">
        <h3 class="text-2xl font-semibold text-slate-100">{entry.data.title}</h3>
        <p class="text-base text-slate-300">
          {entry.data.organization}
          {entry.data.location ? `, ${entry.data.location}` : ""}
        </p>
      </div>
      {entry.data.summary && <p class="leading-7 text-slate-300">{entry.data.summary}</p>}
    </div>
    <p class="technical-label !text-[0.68rem]">{entry.data.timeframe}</p>
  </div>
  <div class="prose-content mt-6">
    <Content />
  </div>
  {
    entry.data.links && entry.data.links.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-3">
        {entry.data.links.map((link) => (
          <a href={link.href} class="button-secondary" target="_blank" rel="noreferrer">
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</article>
