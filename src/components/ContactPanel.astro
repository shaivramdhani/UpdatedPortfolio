---
import { site } from "../data/site";

const linkedIn = site.socialLinks.find((link) => link.label === "LinkedIn");
const github = site.socialLinks.find((link) => link.label === "GitHub");

const contactLinks = [
  { label: "Email", href: `mailto:${site.email}`, value: site.email },
  ...(linkedIn
    ? [{ label: linkedIn.label, href: linkedIn.href, value: linkedIn.href.replace("https://", "").replace("www.", "") }]
    : []),
  ...(github
    ? [{ label: github.label, href: github.href, value: github.href.replace("https://", "").replace("www.", "") }]
    : [])
];
---

<div class="grid gap-6 lg:grid-cols-2 lg:items-start">
  <article class="surface self-start p-6 sm:p-8">
    <div class="flex h-full flex-col gap-6">
      <div class="space-y-3 text-center">
        <h2 class="text-3xl font-semibold tracking-tight text-slate-100 sm:text-4xl">Resume</h2>
        <p class="mx-auto max-w-xl text-base text-slate-300">
          Take a look at my resume to learn more about me.
        </p>
        <div class="mx-auto h-1 w-20 rounded-full bg-accent/75"></div>
      </div>

      <div class="rounded-[1.7rem] border border-[color:var(--color-line-strong)] bg-white/58 p-6 sm:p-8">
        <div class="space-y-6 text-center">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-accent/14 text-accent">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-10 w-10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"></path>
              <path d="M14 2v5h5"></path>
              <path d="M9 13h6"></path>
              <path d="M9 17h6"></path>
              <path d="M9 9h2"></path>
            </svg>
          </div>

          <div class="space-y-2">
            <h3 class="text-2xl font-semibold tracking-tight text-slate-100">Shaiv Ramdhani - Resume</h3>
            <p class="text-lg text-slate-300">Engineering Physics Student</p>
            <p class="text-base text-slate-300">University of British Columbia • Average: 91%</p>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-slate-400">Vancouver, BC</p>
          </div>

          <div class="pt-1">
            <a
              href={site.resume.href}
              class="button-primary px-7 py-3.5 text-base"
              target="_blank"
              rel="noreferrer"
              download
            >
              {site.resume.placeholder ? "View Resume (Coming Soon)" : "Download Resume (PDF)"}
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <article class="surface p-6 sm:p-8 lg:min-h-[22rem]">
    <div class="space-y-4">
      <span class="technical-label">Contact</span>
      <div class="grid gap-3">
        {contactLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-[1.4rem] border border-[color:var(--color-line)] bg-white/70 px-5 py-4 hover:border-accent"
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          >
            <p class="font-mono text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-slate-400">
              {link.label}
            </p>
            <p class="mt-2 text-base text-slate-200">{link.value}</p>
          </a>
        ))}
      </div>
    </div>
  </article>
</div>
