---
type Props = {
  eyebrow: string;
  title: string;
  description?: string;
};

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl space-y-4">
  <span class="technical-label">{eyebrow}</span>
  <div class="space-y-3">
    <h2 class="text-3xl font-semibold tracking-tight text-slate-100 sm:text-4xl">{title}</h2>
    {description && <p class="max-w-2xl text-base leading-8 text-slate-300">{description}</p>}
  </div>
</div>
