---
import type { CollectionEntry } from "astro:content";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
---

<article class="surface flex h-full flex-col overflow-hidden">
  <img
    src={project.data.thumbnail}
    alt={`${project.data.title} thumbnail`}
    class="h-48 w-full border-b border-[color:var(--color-line)] object-cover"
    loading="lazy"
  />
  <div class="flex flex-1 flex-col gap-5 p-6">
    <div class="space-y-3">
      <div class="flex flex-wrap items-center gap-3 text-sm text-slate-400">
        <span class="technical-label !text-[0.68rem]">{project.data.date}</span>
        <span class="font-mono uppercase tracking-[0.16em]">{project.data.role}</span>
      </div>
      <h3 class="text-xl font-semibold text-slate-100">{project.data.title}</h3>
      <p class="leading-7 text-slate-300">{project.data.summary}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      {project.data.tags.map((tag) => (
        <span class="pill">{tag}</span>
      ))}
    </div>
    <div class="mt-auto pt-2">
      <a href={`/projects/${project.slug}/`} class="button-secondary">
        Read case study
      </a>
    </div>
  </div>
</article>
