---
import ContactPanel from "../components/ContactPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | Shaiv Ramdhani">
  <section class="page-section min-h-[calc(100svh-10rem)]">
    <div class="site-shell space-y-8">
      <header class="section-frame p-6 sm:p-8 lg:p-10">
        <span class="technical-label">Contact</span>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-100 sm:text-5xl">
          Feel free to reach out!
        </h1>
      </header>

      <ContactPanel />
    </div>
  </section>
</BaseLayout>
