---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.showOnProjectsPage)
  .sort((a, b) => {
    const orderA = a.data.projectsPageOrder ?? Number.POSITIVE_INFINITY;
    const orderB = b.data.projectsPageOrder ?? Number.POSITIVE_INFINITY;

    return orderA - orderB || b.data.date.localeCompare(a.data.date);
  });
---

<BaseLayout title="Projects | Shaiv Ramdhani">
  <section class="page-section">
    <div class="site-shell page-stack">
      <div class="section-frame">
        <SectionHeading
          eyebrow="Projects"
          title="Selected Engineering Projects"
          description="A concise look at work I designed and built."
        />
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
