---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const summaryParagraphs = site.summary
  .split("\n\n")
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<BaseLayout title="About | Shaiv Ramdhani">
  <section class="page-section">
    <div class="site-shell">
      <article class="surface max-w-4xl space-y-8 p-8 sm:p-10">
        <div class="space-y-4">
          <span class="technical-label">About</span>
          <h1 class="text-4xl font-semibold tracking-tight text-slate-100 sm:text-5xl">
            {site.title}
          </h1>
          <p class="max-w-3xl text-lg leading-8 text-slate-300">{site.headline}</p>
        </div>
        <div class="max-w-3xl space-y-5 text-[1.02rem] leading-8 text-slate-200">
          {summaryParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
