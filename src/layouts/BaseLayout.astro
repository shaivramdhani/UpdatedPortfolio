---
import { site } from "../data/site";
import Nav from "../components/Nav.astro";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  hideNav?: boolean;
  ogType?: string;
  ogUrl?: string;
  ogImage?: string;
  twitterCard?: string;
};

const {
  title = site.seo.defaultTitle,
  description = site.seo.defaultDescription,
  hideNav = false,
  ogType = "website",
  ogUrl = site.seo.siteUrl,
  ogImage = site.seo.ogImagePath,
  twitterCard = "summary_large_image"
} = Astro.props;

const resolvedOgImage = ogImage.startsWith("http") ? ogImage : `${site.seo.siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={site.seo.faviconPath} />
    <link rel="apple-touch-icon" href={site.seo.faviconPath} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <title>{title}</title>
  </head>
  <body>
    {hideNav ? null : <Nav />}
    <main class="site-main">
      <slot />
    </main>
    <footer class="border-t border-[color:var(--color-line)] bg-white/54 py-8 backdrop-blur">
      <div class="site-shell flex flex-col gap-3 text-sm text-slate-400 md:flex-row md:items-center md:justify-between">
        <p>{site.name}</p>
        <div class="flex flex-wrap gap-4">
          {site.socialLinks.map((link) => (
            <a
              href={link.href}
              class="hover:text-accent"
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </footer>
  </body>
</html>
